# Firma los JWT del personal. Obligatoria con DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Obligatoria: cadena de conexión PostgreSQL de Neon. No hay otra base de datos.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Panel de la pollería (Vite usa el 5174; el panel admin usa el 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5174,https://app.delismart.com
# URL pública del backend, para armar los enlaces a comprobantes e imágenes.
PUBLIC_BASE_URL=http://localhost:8001

# Licencias: el backend admin (delismart-admin-saas-back) es la fuente de verdad.
# Sin ADMIN_SAAS_API_URL se usa la copia local de la licencia guardada en cada restaurante.
ADMIN_SAAS_API_URL=
INTERNAL_API_TOKEN=
# local: si el admin no responde, usa la última licencia conocida. deny: bloquea.
LICENSE_FALLBACK=local
LICENSE_CACHE_SECONDS=300

# Integraciones. Con INTEGRATIONS_MOCK=true todo corre simulado, aunque haya claves.
# Sin una clave, ese servicio también pasa a modo simulado.
INTEGRATIONS_MOCK=true

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps Routes API
GOOGLE_MAPS_API_KEY=
